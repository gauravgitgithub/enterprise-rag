# Copy to .env for local dev. In k8s these come from a Secret / ConfigMap instead.
RAG_DATABASE_URL=postgresql+asyncpg://rag_app:CHANGE_ME@localhost:5433/rag
RAG_DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/rag
RAG_RELAY_DATABASE_URL=postgresql+asyncpg://rag_relay:CHANGE_ME@localhost:5433/rag
RAG_AWS_REGION=eu-west-1
RAG_INGEST_QUEUE_URL=http://localhost:9324/000000000000/ingest
RAG_S3_BUCKET=documents
RAG_TEI_URL=http://localhost:8080
# Second TEI instance serving BAAI/bge-reranker-v2-m3.
RAG_RERANK_URL=http://localhost:8081
# Local only: point boto3 at ElasticMQ / SeaweedFS instead of AWS.
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ENDPOINT_URL_S3=http://localhost:8333
# Query API: the OIDC identity provider whose access tokens carry tenant_id and groups claims.
RAG_JWT_ISSUER=https://idp.example.com
RAG_JWT_AUDIENCE=enterprise-rag
RAG_JWKS_URL=https://idp.example.com/.well-known/jwks.json
